---
import "../styles/global.css";
import { NOINDEX } from "../lib/env";
import { homeFaq } from "../data/home-faq";

export interface Props {
  title?: string;
  description?: string;
  path?: string; // canonical path, e.g. "/" or "/privacy-policy"
  home?: boolean; // include SoftwareApplication + FAQPage JSON-LD
  /** Extra JSON-LD blocks (BlogPosting, BreadcrumbList, FAQPage, Person…). */
  jsonLd?: object[];
  ogType?: "website" | "article";
  /** Absolute or site-relative OG image override. Articles pass their hero. */
  image?: string;
  /** Article-only Open Graph fields. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  /** Force noindex on an otherwise-indexable build (draft posts in preview). */
  noindex?: boolean;
}

const {
  title = "Listening Device for iPhone | Clarive: Amplify + Captions",
  description = "Turn your iPhone into a real-time listening device. Amplify voices and read live captions in 40+ languages. Any headphones. Free to download, on-device.",
  path = "/",
  home = false,
  jsonLd = [],
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
} = Astro.props;

const SITE = "https://listeningdevice.app";
// Normalize to a trailing slash so canonical + og:url match the sitemap and the
// directory URLs Astro/Vercel actually serve (e.g. /privacy-policy/).
const canonicalPath = path.endsWith("/") ? path : `${path}/`;
const canonical = new URL(canonicalPath, SITE).href;
// Always absolute against production, never the *.vercel.app preview host — a
// leaked preview page should still point authority at the real domain.
const ogImage = image ? new URL(image, SITE).href : `${SITE}/og-image.png`;
// NOINDEX covers every non-production build; `noindex` covers a draft that
// somehow reaches one that is.
const blockIndexing = NOINDEX || noindex;
const APP_URL = "https://apps.apple.com/us/app/listening-device-clarive/id6748903280";

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Listening Device: Clarive",
  alternateName: "Clarive",
  applicationCategory: "HealthApplication",
  operatingSystem: "iOS 17+",
  // Freemium: free to download, paid plans unlock unlimited use.
  //
  // A PRICE RANGE, deliberately, not a list of SKUs. Superwall carries five
  // products (weekly/monthly/yearly/promo-yearly/lifetime) and two of them had
  // their prices changed on 2026-08-20. Enumerating exact prices here means the
  // schema is wrong every time a paywall experiment ships. The range stays true
  // across those changes; the App Store listing is the authority on today's exact
  // number. Verified against Superwall project 17918 on 2026-08-22.
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "USD",
    lowPrice: "0",
    highPrice: "29.99",
    offerCount: 6,
    description:
      "Free to download with a limited free tier. Paid plans unlock unlimited use; see the App Store listing for current pricing.",
  },
  aggregateRating: { "@type": "AggregateRating", ratingValue: "4.8", ratingCount: "5" },
  description:
    "Real-time audio amplification and live captions for people with mild hearing difficulty. Turns iPhone and headphones into a powerful listening device.",
  url: SITE + "/",
  downloadUrl: APP_URL,
  installUrl: APP_URL,
  sameAs: [APP_URL],
  featureList: [
    "Real-time audio amplification",
    "Live captions in 40+ languages",
    "Voice Isolation and Focus Mode",
    "On-device processing, no audio sent to servers",
    "Works with any headphones",
  ],
  publisher: { "@type": "Organization", name: "Harshva Technology Private Limited" },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  // Built from the same array the visible accordion renders, so the schema text
  // and the on-page text cannot drift. See src/data/home-faq.ts.
  mainEntity: homeFaq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    {blockIndexing && <meta name="robots" content="noindex,nofollow" />}

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#ff3b30" />

    <!-- Theme + iOS web-app -->
    <meta name="theme-color" content="#0a0a0c" />
    <meta name="color-scheme" content="dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Clarive" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Native iOS Safari smart app banner -->
    <meta name="apple-itunes-app" content="app-id=6748903280" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Clarive" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    {[...(home ? [softwareLd, faqLd] : []), ...jsonLd].map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}

    <!-- Analytics -->
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WD4RQW7ZZF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-WD4RQW7ZZF");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

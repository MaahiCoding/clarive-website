---
interface Crumb {
  label: string;
  href?: string; // omitted on the current page
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="text-sm">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-secondary">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-white">{item.label}</a>
        ) : (
          <span class="text-secondary" aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && (
          <span aria-hidden="true" class="text-hairline">/</span>
        )}
      </li>
    ))}
  </ol>
</nav>

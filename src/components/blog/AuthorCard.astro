---
import EarMark from "../EarMark.astro";

interface Props {
  author: string;
  /** Required whenever the article touches hearing health. See claims-guardrails.md. */
  showDisclaimer?: boolean;
  updatedDate?: Date;
}

const { author, showDisclaimer = false, updatedDate } = Astro.props;
const LINKEDIN = "https://www.linkedin.com/in/ios-mahipal/";
---
<div class="mt-14 rounded-[1.25rem] border border-hairline bg-charcoal p-6 sm:p-7">
  <div class="flex items-start gap-4">
    <span
      class="grid h-12 w-12 shrink-0 place-items-center rounded-[0.9rem] bg-gradient-crimson text-white glow-crimson"
      aria-hidden="true"
    >
      <EarMark size={26} />
    </span>

    <div>
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-secondary">
        Written by
      </p>
      <p class="mt-1 text-lg font-semibold tracking-tight text-white">{author}</p>
      <p class="mt-2 text-sm leading-relaxed text-secondary">
        iOS product engineer and the developer of Clarive. Writes about iPhone audio, live
        captions, and making everyday conversations easier to follow.
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        <a href="/about/" class="text-crimson-light underline underline-offset-4 hover:text-crimson">
          About the author
        </a>
        <a
          href={LINKEDIN}
          target="_blank"
          rel="noopener"
          class="text-crimson-light underline underline-offset-4 hover:text-crimson"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>

  {updatedDate && (
    <p class="mt-5 border-t border-hairline pt-4 text-xs text-secondary">
      Last reviewed and updated on{" "}
      <time datetime={updatedDate.toISOString()}>
        {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
      </time>.
    </p>
  )}

  {showDisclaimer && (
    <p class="mt-4 rounded-xl border border-hairline bg-ink p-4 text-xs leading-relaxed text-secondary">
      Clarive is a sound amplification app, not a hearing aid or medical device. It doesn't
      diagnose or treat hearing loss. If you're having trouble hearing, see an audiologist or your
      doctor.
    </p>
  )}
</div>

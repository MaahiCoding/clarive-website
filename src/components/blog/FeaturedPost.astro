---
import { Image } from "astro:assets";
import { CLUSTERS } from "../../content.config";
import { postUrl, formatDate, type Post } from "../../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, cluster, heroImage, heroAlt, publishDate, shortAnswer, draft } =
  post.data;
---
<article class="post-card reveal flex flex-col sm:grid sm:grid-cols-5 sm:items-stretch">
  <div class="relative aspect-[16/10] w-full overflow-hidden sm:col-span-3 sm:aspect-auto">
    {heroImage ? (
      <Image
        src={heroImage}
        alt={heroAlt ?? ""}
        widths={[600, 1200]}
        sizes="(min-width: 640px) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="hero-fallback h-full min-h-[13rem] w-full" aria-hidden="true">
        <span class="px-8 text-center text-2xl font-semibold leading-tight tracking-tight text-white/90">
          {title}
        </span>
      </div>
    )}
    {draft && (
      <span class="absolute left-3 top-3 rounded-full bg-crimson px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-white">
        Draft
      </span>
    )}
  </div>

  <div class="flex flex-col justify-center p-6 sm:col-span-2 sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-crimson">
      Latest · {CLUSTERS[cluster].title}
    </p>

    <h2 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-white sm:text-[1.75rem]">
      <a href={postUrl(post.id)} class="stretched outline-none">{title}</a>
    </h2>

    <p class="mt-3 text-[0.95rem] leading-relaxed text-secondary">
      {description || shortAnswer}
    </p>

    <div class="mt-5 flex items-center gap-3 text-xs text-secondary">
      <time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
      <span aria-hidden="true">·</span>
      <span class="font-medium text-crimson">Read article</span>
    </div>
  </div>
</article>

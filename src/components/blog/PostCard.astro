---
import { Image } from "astro:assets";
import { CLUSTERS } from "../../content.config";
import { postUrl, formatDate, type Post } from "../../lib/posts";

interface Props {
  post: Post;
  /** Eager-load the first row on the index; everything below the fold stays lazy. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, cluster, heroImage, heroAlt, publishDate, draft } = post.data;
---
<article class="post-card reveal flex flex-col">
  <div class="relative aspect-[16/9] w-full overflow-hidden">
    {heroImage ? (
      <Image
        src={heroImage}
        alt={heroAlt ?? ""}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="hero-fallback h-full w-full" aria-hidden="true">
        <span class="px-6 text-center text-lg font-semibold leading-snug text-white/90">
          {title}
        </span>
      </div>
    )}
    {draft && (
      <span class="absolute left-3 top-3 rounded-full bg-crimson px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-white">
        Draft
      </span>
    )}
  </div>

  <div class="flex flex-1 flex-col p-5">
    <p class="text-xs font-semibold uppercase tracking-wider text-crimson">
      {CLUSTERS[cluster].title}
    </p>

    <h3 class="mt-2.5 text-[1.15rem] font-semibold leading-snug tracking-tight text-white">
      <a href={postUrl(post.id)} class="stretched outline-none">{title}</a>
    </h3>

    <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-secondary">{description}</p>

    <time datetime={publishDate.toISOString()} class="mt-4 pt-1 text-xs text-secondary">
      {formatDate(publishDate)}
    </time>
  </div>
</article>

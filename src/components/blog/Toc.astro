---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// H1 is the article title; H4+ is too granular to navigate by.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length >= 3 && (
  <nav aria-labelledby="toc-heading" class="sticky top-28">
    <h2 id="toc-heading" class="mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-secondary">
      On this page
    </h2>
    <ul id="toc-list">
      {items.map((h) => (
        <li>
          <a href={`#${h.slug}`} class:list={["toc-link", `depth-${h.depth}`]} data-toc-link={h.slug}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
  (() => {
    const links = document.querySelectorAll("[data-toc-link]");
    if (!links.length) return;

    const byId = new Map();
    links.forEach((l) => byId.set(l.dataset.tocLink, l));

    const targets = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter(Boolean);
    if (!targets.length) return;

    let activeId = null;
    const setActive = (id) => {
      if (id === activeId) return;
      if (activeId) byId.get(activeId)?.classList.remove("is-active");
      byId.get(id)?.classList.add("is-active");
      activeId = id;
    };

    // Mark the last heading scrolled past, rather than whichever happens to be
    // intersecting — that keeps a section active while you read the body under
    // it, which is what a reader expects.
    const onScroll = () => {
      const line = window.scrollY + 140;
      let current = targets[0];
      for (const t of targets) {
        if (t.offsetTop <= line) current = t;
        else break;
      }
      setActive(current.id);
    };

    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>

# Build output
dist/
.astro/

# Dependencies
node_modules/
yarn.lock
pnpm-lock.yaml
# package-lock.json is intentionally COMMITTED — Vercel needs it for reproducible
# installs. It was already tracked, so the previous ignore line had no effect.

# Environment variables (NEVER COMMIT - always keep secret)
# Broad glob so a stray .env.preview / .env.staging can't slip through.
.env*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor
.idea/
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Vercel
.vercel
.vercelignore

# Local cache
.cache/
.firecrawl/

# Operating System
.AppleDouble
.LSOverride

# Testing
.nyc_output/
coverage/
*.lcov

